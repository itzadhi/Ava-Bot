# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
OWNER_IDS=123456789012345678,987654321098765432
BOT_NAME=Argoni
DEFAULT_PREFIX=a!
OWNER_PREFIX=ao!

# Supabase (Postgres & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Encryption (32-byte hex or random string for AES-256-GCM message encryption)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Shop Item Stock Encryption (32-byte hex string for AES-256-GCM item accounts/keys encryption)
SHOP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Brand & Link URLs
SUPPORT_SERVER_URL=https://discord.gg/argoni
INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands
WEBSITE_URL=https://argoni.app
DOCS_URL=https://argoni.app/docs
PRIVACY_URL=https://argoni.app/privacy
TERMS_URL=https://argoni.app/terms

# Logging & Environment
LOG_LEVEL=info
NODE_ENV=development

# Voice & Join-to-Create (JTC) Configuration
DEFAULT_JTC_TEMPLATE="{username}'s room" # Default template for newly created temporary voice rooms
DEFAULT_JTC_LIMIT=0                      # Default user limit for temporary voice channels (0 = unlimited)

# Suggestions & Feedback Configuration
DEFAULT_SUGGESTION_COOLDOWN=60           # Default cooldown in seconds per user between /suggest submissions

# Text-To-Speech (TTS) Voice Configuration
TTS_DEFAULT_LANGUAGE=en                  # Default TTS speech language (e.g., en, es, fr, de, ja)
TTS_CHAR_LIMIT=200                       # Maximum sanitized character length spoken per chat message
TTS_RATE_LIMIT_MS=3000                   # Cooldown in milliseconds per user between spoken TTS messages
TTS_MAX_QUEUE_SIZE=20                    # Maximum speech queue capacity per guild voice channel

# Custom Brand Emojis (Optional: Set Discord custom emojis <:name:id> or <a:name:id>, or leave unset for clean Unicode fallbacks)
# EMOJI_DOT=•
# EMOJI_ARROW=❯
# EMOJI_BUTTERFLY=🦋
# EMOJI_SUCCESS=✅
# EMOJI_ERROR=❌
# EMOJI_WARN=⚠️
# EMOJI_LOADING=⏳
# EMOJI_ON=🟢
# EMOJI_OFF=🔴
# EMOJI_INFO=ℹ️
# EMOJI_STAR=⭐
# EMOJI_GEAR=⚙️
